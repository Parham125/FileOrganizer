{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileOrganizer",
  "version": "0.10.3",
  "identifier": "com.parham.fileorganizer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FileOrganizer",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBNEVFQzczOENCNDc3ODEKUldTQmQ3U01jK3hPYXVCaDdDTXhUVXA5Y2Q0dTc3elNWOUpEeDBZOWxRNy9KZmhPRTJLbndhejUK",
      "endpoints": [
        "https://github.com/Parham125/FileOrganizer/releases/latest/download/latest.json"
      ]
    }
  }
}
